# Local: values printed by `supabase start`. Production: set as repo secrets/vars.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Base path the app is served from (GitHub Pages: /<repo>/).
VITE_BASE=/
# Show the "Continue with Google" button (enable the provider in Supabase first).
VITE_GOOGLE_AUTH=false
