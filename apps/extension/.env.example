# Build-time defaults; the extension's settings page can override all three.
# Local: values printed by `supabase start`. Releases: the repo's secrets/vars.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_WEB_APP_URL=http://localhost:5173/
# Firefox add-on id; AMO needs one unique to whoever signs the add-on.
EXT_GECKO_ID=apartment-together@example.com
