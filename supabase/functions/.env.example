CRON_SECRET=local-cron-secret
# Optional: a contact address sent to Nominatim with geocoding requests (its usage policy asks for one).
# NOMINATIM_EMAIL=you@example.com
# Web Push (send-push). Shared secret the database sends with each request; the
# local seed stores the same value in Vault as `push_webhook_secret`.
PUSH_WEBHOOK_SECRET=local-push-secret
# VAPID keys: generate with `npx web-push generate-vapid-keys` and put the public
# key in apps/web/.env.local as VITE_VAPID_PUBLIC_KEY too. Without them, send-push
# skips delivery (the in-app feed still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# TRANSITOUS_URL=https://api.transitous.org/api/v1/plan  (override if Transitous changes its API version)
